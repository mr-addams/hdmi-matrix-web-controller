# Sign-in to the web controller (sign-in form). The default values are weak; change them.
UI_USER=admin
UI_PASSWORD=admin
# Version of the published image (see the releases). The installer writes it.
HDMI_UI_VERSION=0.1.0
# Port the page is published on, and the address it is bound to.
# 127.0.0.1 means this machine only; 0.0.0.0 means the whole local network.
MATRIX_UI_PORT=8080
MATRIX_UI_BIND=127.0.0.1
