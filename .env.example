# Вход на страницу управления (форма входа). Значения по умолчанию слабые — поменяй.
UI_USER=admin
UI_PASSWORD=admin
# Версия опубликованного образа (см. релизы). Установщик пишет её сам.
HDMI_UI_VERSION=0.1.0
# Порт страницы и адрес, на котором она опубликована.
# 127.0.0.1 — только эта машина; 0.0.0.0 — вся локальная сеть.
MATRIX_UI_PORT=8080
MATRIX_UI_BIND=127.0.0.1
